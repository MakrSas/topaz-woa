;
; TopazModem.inf - modem DSP (MPSS) + WLAN firmware bring-up for Redmi Note 12 4G (topaz/tapas, SM6225)
; Root-enumerated KMDF driver: TrustZone PAS boot, SMP2P, GLINK/QRTR, pd-mapper/tftp/rmtfs, WLFW.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = TopazModem.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TopazModem.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = TopazModem_Device, Root\TopazModem

[TopazModem_Device.NT]
CopyFiles = TopazModem_CopyFiles

[TopazModem_CopyFiles]
TopazModem.sys

[TopazModem_Device.NT.Services]
AddService = TopazModem, 0x00000002, TopazModem_Service

[TopazModem_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\TopazModem.sys

[TopazModem_Device.NT.Wdf]
KmdfService = TopazModem, TopazModem_WdfSection

[TopazModem_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "topaz-woa"
ManufacturerName = "topaz-woa"
DiskName         = "TopazModem Installation Disk"
DeviceDesc       = "Modem DSP and WLAN firmware (Redmi Note 12 4G)"
ServiceName      = "TopazModem"
