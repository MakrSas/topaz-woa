;
; TopazTouch.inf - FocalTech touchscreen for Redmi Note 12 4G (topaz/tapas, SM6225)
; Root-enumerated KMDF source driver, exposes a HID touch screen through VHF.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = TopazTouch.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TopazTouch.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = TopazTouch_Device, Root\TopazTouch

[TopazTouch_Device.NT]
CopyFiles = TopazTouch_CopyFiles

[TopazTouch_CopyFiles]
TopazTouch.sys

[TopazTouch_Device.NT.HW]
AddReg = TopazTouch_HwAddReg

[TopazTouch_HwAddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[TopazTouch_Device.NT.Services]
AddService = TopazTouch, 0x00000002, TopazTouch_Service

[TopazTouch_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\TopazTouch.sys

[TopazTouch_Device.NT.Wdf]
KmdfService = TopazTouch, TopazTouch_WdfSection

[TopazTouch_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "topaz-woa"
ManufacturerName = "topaz-woa"
DiskName         = "TopazTouch Installation Disk"
DeviceDesc       = "FocalTech Touch Screen (Redmi Note 12 4G)"
ServiceName      = "TopazTouch"
