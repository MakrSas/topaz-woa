;
; TopazAudio.inf - ADSP (LPASS) bring-up for sound on Redmi Note 12 4G (topaz/tapas, SM6225)
; Root-enumerated KMDF driver: TrustZone PAS boot, SMP2P, GLINK/QRTR, pd-mapper, GPR.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = TopazAudio.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TopazAudio.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = TopazAudio_Device, Root\TopazAudio

[TopazAudio_Device.NT]
CopyFiles = TopazAudio_CopyFiles

[TopazAudio_CopyFiles]
TopazAudio.sys

; admin + SYSTEM only: the lab interface (\\.\TopazAudio) pokes hardware
[TopazAudio_Device.NT.HW]
AddReg = TopazAudio_Security

[TopazAudio_Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[TopazAudio_Device.NT.Services]
AddService = TopazAudio, 0x00000002, TopazAudio_Service

[TopazAudio_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\TopazAudio.sys

[TopazAudio_Device.NT.Wdf]
KmdfService = TopazAudio, TopazAudio_WdfSection

[TopazAudio_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "topaz-woa"
ManufacturerName = "topaz-woa"
DiskName         = "TopazAudio Installation Disk"
DeviceDesc       = "Audio DSP (Redmi Note 12 4G)"
ServiceName      = "TopazAudio"
