;
; TopazGpuW.inf - WDDM driver for the Adreno 610 of Redmi Note 12 4G (topaz, SM6225).
; Step A (docs/P8_gpu.md): render-only adapter next to TopazDisplay; the freedreno UMD
; talks to it through escapes carrying the Linux msm ioctls. Root-enumerated.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = TopazGpuW.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TopazGpuW.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = TopazGpuW_Inst, Root\TopazGpuW
; step C: ACPI device GPU0 from our UEFI DSDT (uefi/acpi), with the GPU interrupt (GSIV 209)
%DeviceDesc% = TopazGpuW_Inst, ACPI\TPZG0610

[TopazGpuW_Inst]
FeatureScore = F8
CopyFiles = TopazGpuW_Files
AddReg = TopazGpuW_UmdReg

; Dxgkrnl reads these for every adapter that renders (v0.5 failed start with c0000034 without them).
; The UMD is Mesa freedreno + d3d10umd (mesa-overlay), installed to System32 as topazgpu_d3d10.dll.
[TopazGpuW_UmdReg]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,topazgpu_d3d10.dll,topazgpu_d3d10.dll,topazgpu_d3d10.dll,topazgpu_d3d10.dll
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,topazgpu_d3d10
HKR,,VgaCompatible,%REG_DWORD%,0

[TopazGpuW_Files]
TopazGpuW.sys

[TopazGpuW_Inst.Services]
AddService = TopazGpuW, 0x00000002, TopazGpuW_Service, TopazGpuW_EventLog

[TopazGpuW_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 0               ; SERVICE_ERROR_IGNORE
ServiceBinary = %12%\TopazGpuW.sys

[TopazGpuW_EventLog]
AddReg = TopazGpuW_EventLog_AddReg

[TopazGpuW_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,0x00010001,7

[Strings]
REG_MULTI_SZ     = 0x00010000
REG_DWORD        = 0x00010001
ProviderName     = "topaz-woa"
ManufacturerName = "topaz-woa"
DiskName         = "TopazGpuW Installation Disk"
DeviceDesc       = "Qualcomm Adreno 610 (topaz-woa)"
ServiceName      = "TopazGpuW"
