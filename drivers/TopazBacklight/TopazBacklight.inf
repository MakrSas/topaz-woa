;
; TopazBacklight.inf - panel brightness of Redmi Note 12 4G (topaz, SM6225): DCS 0x51 over DSI0
; Root-enumerated KMDF driver; level from C:\topaz\brightness (0-100).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = TopazBacklight.cat
DriverVer   = ; set by stampinf
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TopazBacklight.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = TopazBacklight_Device, Root\TopazBacklight

[TopazBacklight_Device.NT]
CopyFiles = TopazBacklight_CopyFiles

[TopazBacklight_CopyFiles]
TopazBacklight.sys

[TopazBacklight_Device.NT.Services]
AddService = TopazBacklight, 0x00000002, TopazBacklight_Service

[TopazBacklight_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\TopazBacklight.sys

[TopazBacklight_Device.NT.Wdf]
KmdfService = TopazBacklight, TopazBacklight_WdfSection

[TopazBacklight_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName     = "topaz-woa"
ManufacturerName = "topaz-woa"
DiskName         = "TopazBacklight Installation Disk"
DeviceDesc       = "Panel Brightness (Redmi Note 12 4G)"
ServiceName      = "TopazBacklight"
