+/* TopazGpu: switches from C:\ProgramData\topaz\umd.env (read by the UMD into the environment) */
+static bool
+ttn_topaz_flag(const char *name)
+{
+   const char *v = getenv(name);
+   return v && v[0] == '1';
+}
+
 static void
 ttn_kill(nir_builder *b)
 {
+   if (ttn_topaz_flag("TOPAZ_DEMOTE")) {
+      /* D3D discard keeps the pixel as a helper lane (derivatives of its quad stay valid) */
+      nir_demote(b);
+      b->shader->info.fs.uses_demote = true;
+      return;
+   }
    nir_discard(b);
    b->shader->info.fs.uses_discard = true;
 }
