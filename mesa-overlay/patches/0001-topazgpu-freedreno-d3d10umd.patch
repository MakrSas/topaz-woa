diff --git a/src/gallium/targets/d3d10umd/d3d10_gdi.c b/src/gallium/targets/d3d10umd/d3d10_gdi.c
index b8ab9f5..db17fa6 100644
--- a/src/gallium/targets/d3d10umd/d3d10_gdi.c
+++ b/src/gallium/targets/d3d10umd/d3d10_gdi.c
@@ -34,6 +34,18 @@
 #include "softpipe/sp_public.h"
 #include "sw/gdi/gdi_sw_winsys.h"
 #include "virgl/gdi/virgl_gdi_public.h"
+#ifdef GALLIUM_FREEDRENO
+#include "freedreno/freedreno_screen.h"
+#include "xf86drm.h"
+
+/* TopazGpu: DRM ioctls of freedreno travel as escapes through the D3D10 device callbacks */
+static int
+d3d10_fd_escape(void *ctx, void *data, unsigned size)
+{
+   struct gdikmt_device *device = (struct gdikmt_device *)ctx;
+   return device->escape(device, data, size) >= 0 ? 0 : -1;
+}
+#endif
 
 #include "winddk_compat.h"
 #include <d3dkmthk.h>
@@ -66,6 +78,15 @@ d3d10_create_screen(struct gdikmt_device* device)
 #ifdef GALLIUM_VIRGL
    return virgl_gdi_screen_create(device);
 #endif
+#ifdef GALLIUM_FREEDRENO
+   {
+      int fd = fd_wddm_open(d3d10_fd_escape, device);
+      if (fd < 0)
+         return NULL;
+      screen = fd_screen_create(fd, NULL, NULL);
+      return screen ? debug_screen_wrap(screen) : NULL;
+   }
+#endif
 
 
    winsys = gdi_create_sw_winsys(d3d10_gdi_acquire_hdc, d3d10_gdi_release_hdc);
