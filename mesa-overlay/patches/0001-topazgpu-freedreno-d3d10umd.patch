diff --git a/meson.build b/meson.build
index 1b1f5b8..45145cc 100644
--- a/meson.build
+++ b/meson.build
@@ -783,13 +783,21 @@ if with_gallium_st_nine
   endif
 endif
 
+# TopazGpu: freedreno on Windows talks to the WDDM KMD through a libdrm shim (src/freedreno/drm/wddm)
+if with_gallium_freedreno and host_machine.system() == 'windows'
+  pre_args += ['-I' + (meson.current_source_dir() / 'src' / 'freedreno' / 'drm' / 'wddm' / 'include'),
+               '-I' + (meson.current_source_dir() / 'src' / 'freedreno' / 'drm' / 'wddm'),
+               '-DFD_WDDM']
+endif
+
 with_gallium_st_d3d10umd =  get_option('gallium-d3d10umd')
 if with_gallium_st_d3d10umd
   if not [
            with_gallium_swrast,
            with_gallium_virgl,
+           with_gallium_freedreno,
          ].contains(true)
-    error('The d3d10umd state tracker requires gallium softpipe/llvmpipe or virgl.')
+    error('The d3d10umd state tracker requires gallium softpipe/llvmpipe, virgl or freedreno.')
   endif
   if with_gallium_softpipe and with_gallium_virgl
     warning('The d3d10umd state trackes is built with both softpipe/llvmpipe and virgl, only virgl will be used.')
diff --git a/src/freedreno/drm/freedreno_device.c b/src/freedreno/drm/freedreno_device.c
index ce95c9f..06222a2 100644
--- a/src/freedreno/drm/freedreno_device.c
+++ b/src/freedreno/drm/freedreno_device.c
@@ -147,6 +147,13 @@ fail:
 struct fd_device *
 fd_device_new_dup(int fd)
 {
+#ifdef FD_WDDM
+   /* fake DRM fds of the TopazGpu shim cannot be dup()ed: share it */
+   struct fd_device *wdev = fd_device_new(fd);
+   if (wdev)
+      wdev->closefd = 0;
+   return wdev;
+#endif
    int dup_fd = os_dupfd_cloexec(fd);
    struct fd_device *dev = fd_device_new(dup_fd);
    if (dev)
