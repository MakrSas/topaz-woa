            Name (_CRS, ResourceTemplate ()
            {
                Memory32Fixed (ReadWrite, 0x04E00000, 0x000FFFFF, )
                Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive, ,, ) { 0x0000011F }
